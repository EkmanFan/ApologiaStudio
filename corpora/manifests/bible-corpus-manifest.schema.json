{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apologiastudio.local/schemas/bible-corpus-manifest-v1.json",
  "title": "ApologiaStudio Bible corpus provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "edition",
    "source",
    "selection",
    "processing",
    "validation",
    "editorialAudit"
  ],
  "properties": {
    "$schema": {
      "const": "./bible-corpus-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "approvedCorpusCode",
        "displayName",
        "languageTag",
        "canonCode",
        "license"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "approvedCorpusCode": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "languageTag": { "type": "string", "minLength": 2 },
        "canonCode": { "const": "protestant-66" },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourceUri"],
          "properties": {
            "status": { "const": "public-domain" },
            "sourceUri": { "type": "string", "pattern": "^https://" },
            "notice": { "type": "string" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "upstreamDistributionId",
        "detailsUri",
        "capturedAt",
        "artifacts"
      ],
      "properties": {
        "provider": { "const": "eBible.org" },
        "upstreamDistributionId": { "type": "string", "minLength": 1 },
        "detailsUri": { "type": "string", "pattern": "^https://" },
        "capturedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "usfmIncludedBookCount",
        "vplIncludedBookCount",
        "excludedUsfmIds"
      ],
      "properties": {
        "policy": { "const": "protestant-66-only" },
        "usfmIncludedBookCount": { "const": 66 },
        "vplIncludedBookCount": { "const": 66 },
        "excludedUsfmIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalFormat",
        "validationFormat",
        "storedFormat",
        "parser",
        "normalizationPolicyId"
      ],
      "properties": {
        "canonicalFormat": { "const": "USFM" },
        "validationFormat": { "const": "VPL" },
        "storedFormat": { "const": "normalized-relational" },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "SIL.Machine" },
            "version": { "const": "3.9.1" }
          }
        },
        "normalizationPolicyId": {
          "const": "unicode-nfc-collapse-whitespace-v1"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validatedOn",
        "validatorCommit",
        "sourceIntegrityValidated",
        "formatParityValidated",
        "referenceParityValidated",
        "textParityValidated",
        "usfmFileCount",
        "usfmBookCount",
        "usfmVerseCount",
        "vplFileCount",
        "vplBookCount",
        "vplVerseCount",
        "strongAttributeCount",
        "missingFromUsfm",
        "unexpectedInUsfm",
        "textMismatches",
        "reportPath"
      ],
      "properties": {
        "status": { "const": "passed" },
        "validatedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "validatorCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "sourceIntegrityValidated": { "const": true },
        "formatParityValidated": { "const": true },
        "referenceParityValidated": { "const": true },
        "textParityValidated": { "const": true },
        "usfmFileCount": { "type": "integer", "minimum": 1 },
        "usfmBookCount": { "const": 66 },
        "usfmVerseCount": { "type": "integer", "minimum": 1 },
        "vplFileCount": { "type": "integer", "minimum": 1 },
        "vplBookCount": { "const": 66 },
        "vplVerseCount": { "type": "integer", "minimum": 1 },
        "strongAttributeCount": { "type": "integer", "minimum": 0 },
        "missingFromUsfm": { "const": 0 },
        "unexpectedInUsfm": { "const": 0 },
        "textMismatches": { "const": 0 },
        "reportPath": { "type": "string", "minLength": 1 }
      }
    },
    "editorialAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocksImport"],
      "properties": {
        "status": { "const": "deferred" },
        "blocksImport": { "const": false }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "uri", "fileName", "sha256", "byteLength"],
      "properties": {
        "role": {
          "enum": ["canonical-usfm", "validation-vpl"]
        },
        "uri": { "type": "string", "pattern": "^https://" },
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
