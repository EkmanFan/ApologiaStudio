@using ApologiaStudio.Application.BibleCorpora.Queries
@using ApologiaStudio.Application.BibleCorpora.Reader
@using ApologiaStudio.Domain.Users

@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<section class="bible-reader-shell">
    <button id="studio-sidebar-toggle"
            class="mobile-sidebar-toggle"
            type="button"
            aria-controls="studio-sidebar"
            aria-expanded="@(SidebarIsOpen ? "true" : "false")"
            aria-label="@Text("Ouvrir la navigation", "Open navigation")"
            @onclick="OnOpenSidebar">
        <span aria-hidden="true">☰</span>
    </button>

    @if (Reader.Status != BibleReaderStatus.Ready)
    {
        <main class="reader-state" role="status">
            <span class="reader-state-icon" aria-hidden="true">B</span>
            <h1>@GetStateTitle()</h1>
            <p>@GetStateMessage()</p>

            @if (Reader.Status != BibleReaderStatus.CorpusUnavailable &&
                 Reader.Edition is not null)
            {
                <a class="reader-primary-link"
                   href="@GetEditionUrl(Reader.Edition.Code)">
                    @Text(
                        "Ouvrir le début de cette édition",
                        "Open the beginning of this edition")
                </a>
            }
            else if (Reader.Status != BibleReaderStatus.CorpusUnavailable &&
                     Reader.Editions.Count > 0)
            {
                <div class="available-editions">
                    @foreach (var edition in Reader.Editions)
                    {
                        <a href="@GetEditionUrl(edition.Code)">
                            @edition.DisplayName
                        </a>
                    }
                </div>
            }
        </main>
    }
    else
    {
        var chapter = Reader.Chapter!;

        <header class="reader-header">
            <div>
                <p class="reader-eyebrow">@Reader.Edition!.DisplayName</p>
                <h1>@chapter.Book.DisplayName @chapter.ChapterNumber</h1>
                <p>
                    @Text(
                        "Sélectionnez un verset, puis un second pour former une plage continue.",
                        "Select one verse, then a second to create a continuous range.")
                </p>
            </div>

            <span class="reader-mode-badge">
                @Text("Corpus vérifié", "Verified corpus")
            </span>
        </header>

        <div class="reader-toolbar"
             aria-label="@Text("Navigation biblique", "Bible navigation")">
            <label>
                <span>@Text("Traduction", "Translation")</span>
                <select value="@Reader.Edition.Code"
                        @onchange="ChangeEdition">
                    @foreach (var edition in Reader.Editions)
                    {
                        <option value="@edition.Code">
                            @edition.DisplayName
                        </option>
                    }
                </select>
            </label>

            <label>
                <span>@Text("Livre", "Book")</span>
                <select value="@chapter.Book.Code"
                        @onchange="ChangeBook">
                    @foreach (var book in Reader.Books)
                    {
                        <option value="@book.Code">@book.DisplayName</option>
                    }
                </select>
            </label>

            <label>
                <span>@Text("Chapitre", "Chapter")</span>
                <select value="@chapter.ChapterNumber"
                        @onchange="ChangeChapter">
                    @for (var chapterNumber = 1;
                          chapterNumber <= chapter.Book.ChapterCount;
                          chapterNumber++)
                    {
                        <option value="@chapterNumber">@chapterNumber</option>
                    }
                </select>
            </label>
        </div>

        <nav class="chapter-navigation"
             aria-label="@Text("Navigation entre les chapitres", "Chapter navigation")">
            @if (Reader.PreviousChapter is { } previous)
            {
                <a href="@GetLocationUrl(previous)">
                    <span aria-hidden="true">←</span>
                    @Text("Chapitre précédent", "Previous chapter")
                </a>
            }
            else
            {
                <span class="chapter-link-disabled" aria-disabled="true">
                    <span aria-hidden="true">←</span>
                    @Text("Chapitre précédent", "Previous chapter")
                </span>
            }

            @if (Reader.NextChapter is { } next)
            {
                <a href="@GetLocationUrl(next)">
                    @Text("Chapitre suivant", "Next chapter")
                    <span aria-hidden="true">→</span>
                </a>
            }
            else
            {
                <span class="chapter-link-disabled" aria-disabled="true">
                    @Text("Chapitre suivant", "Next chapter")
                    <span aria-hidden="true">→</span>
                </span>
            }
        </nav>

        <main class="verse-list"
              aria-label="@($"{chapter.Book.DisplayName} {chapter.ChapterNumber}")">
            @foreach (var verse in chapter.Verses)
            {
                <button class="verse-row @(IsSelected(verse.VerseOrdinal) ? "selected" : null)"
                        type="button"
                        aria-pressed="@(IsSelected(verse.VerseOrdinal) ? "true" : "false")"
                        aria-label="@GetVerseAriaLabel(verse)"
                        @onclick="() => SelectVerse(verse.VerseOrdinal)">
                    <span class="verse-number">@verse.VerseLabel</span>
                    <span class="verse-text">@verse.Text</span>
                </button>
            }
        </main>

        <footer class="selection-bar"
                aria-live="polite">
            @if (TryGetSelection(out var selection))
            {
                <div class="selection-copy">
                    <strong>@GetSelectionReference(selection)</strong>
                    <span>
                        @Text(
                            "La question sera préparée, mais jamais envoyée automatiquement.",
                            "The question will be prepared, but never sent automatically.")
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_copyStatus))
                    {
                        <span class="copy-status">@_copyStatus</span>
                    }
                </div>

                <div class="selection-actions">
                    <button type="button"
                            disabled="@IsBusy"
                            @onclick="ClearSelection">
                        @Text("Effacer", "Clear")
                    </button>

                    <button type="button"
                            disabled="@IsBusy"
                            @onclick="CopyReferenceAsync">
                        @Text("Copier la référence", "Copy reference")
                    </button>

                    <button class="primary-action"
                            type="button"
                            disabled="@IsBusy"
                            @onclick="UseInDiscussionAsync">
                        @Text(
                            "Utiliser dans une discussion",
                            "Use in a chat")
                    </button>
                </div>
            }
            else
            {
                <p>
                    @Text(
                        "Sélectionnez un verset pour préparer une référence.",
                        "Select a verse to prepare a reference.")
                </p>
            }
        </footer>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <aside class="reader-error" role="alert">@ErrorMessage</aside>
        }
    }
</section>
