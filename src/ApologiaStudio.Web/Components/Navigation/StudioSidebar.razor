@using ApologiaStudio.Domain.Users
@using Microsoft.AspNetCore.Components.Web

<button class="sidebar-scrim @(IsOpen ? "visible" : null)"
        type="button"
        tabindex="@(IsOpen ? "0" : "-1")"
        aria-label="@Text("Fermer la navigation", "Close navigation")"
        @onclick="CloseAsync">
</button>

<aside id="studio-sidebar"
       class="studio-sidebar @(IsOpen ? "open" : null)"
       aria-label="@Text("Navigation principale", "Primary navigation")">
    <header class="sidebar-header">
        <a class="brand" href="/" @onclick="CloseAsync">
            <span class="brand-mark" aria-hidden="true">A</span>
            <span>
                <strong>Apologia Studio</strong>
                <small>@Text("Atelier apologétique", "Apologetics workspace")</small>
            </span>
        </a>

        <button id="studio-sidebar-close"
                class="sidebar-close"
                type="button"
                aria-label="@Text("Fermer la navigation", "Close navigation")"
                @onclick="CloseAsync">
            <span aria-hidden="true">×</span>
        </button>

        <button class="new-chat"
                type="button"
                disabled="@(IsCreatingConversation || IsBusy)"
                @onclick="CreateConversationAsync">
            <span class="new-chat-icon" aria-hidden="true">＋</span>
            <span>@Text("Nouvelle discussion", "New chat")</span>
        </button>

        <a class="document-manager-link @(IsDocumentManagerActive ? "active" : null)"
           href="/document-manager"
           aria-current="@(IsDocumentManagerActive ? "page" : null)"
           @onclick="CloseAsync">
            <span class="document-manager-icon" aria-hidden="true">▤</span>
            <span>@Text("Gestion des documents", "Document Manager")</span>
        </a>

        <a class="document-manager-link @(IsEditorialReviewActive ? "active" : null)"
           href="/editorial-review"
           aria-current="@(IsEditorialReviewActive ? "page" : null)"
           @onclick="CloseAsync">
            <span class="document-manager-icon" aria-hidden="true">✓</span>
            <span>@Text("Revue éditoriale", "Editorial review")</span>
        </a>
    </header>

    <div class="sidebar-navigation">
        <details class="sidebar-section" open>
            <summary>
                <span>@Text("Bibliothèque", "Library")</span>
                <span class="section-count">@BibleEditions.Count</span>
            </summary>

            <div class="section-content bible-list">
                @if (BibleEditions.Count == 0)
                {
                    <p class="section-empty">
                        @Text(
                            "Aucune Bible n’est disponible.",
                            "No Bible editions are available.")
                    </p>
                }
                else
                {
                    @foreach (var edition in BibleEditions)
                    {
                        <a class="bible-edition @(edition.IsActive ? "active" : null)"
                           href="@edition.Url"
                           title="@edition.Code"
                           aria-current="@(edition.IsActive ? "page" : null)"
                           @onclick="CloseAsync">
                            <span class="item-icon" aria-hidden="true">B</span>
                            <span class="item-copy">
                                <strong>@edition.DisplayName</strong>
                                <small>@GetLanguageLabel(edition.LanguageTag)</small>
                            </span>
                        </a>
                    }
                }
            </div>
        </details>

        <details class="sidebar-section" open>
            <summary>
                <span>@Text("Épinglés", "Pinned")</span>
                <span class="section-count">@PinnedItems.Count</span>
            </summary>

            <nav class="section-content pinned-list"
                 aria-label="@Text("Épinglés", "Pinned")">
                @if (PinnedItems.Count == 0)
                {
                    <p class="section-empty">
                        @Text(
                            "Aucun élément épinglé.",
                            "No pinned items.")
                    </p>
                }
                else
                {
                    @for (var index = 0; index < PinnedItems.Count; index++)
                    {
                        var item = PinnedItems[index];
                        var itemIndex = index;

                        <div class="sidebar-item-row pinned-row"
                             draggable="@(!IsBusy ? "true" : "false")"
                             @ondragstart="() => BeginPinDrag(item.PinId)"
                             @ondragend="ClearDrag"
                             @ondragover:preventDefault
                             @ondrop="() => DropPinAsync(itemIndex)">
                            <a class="pinned-link @(item.IsProject ? "project-shortcut" : null) @(item.IsActive ? "active" : null)"
                               href="@item.Url"
                               aria-current="@(item.IsActive ? "page" : null)"
                               @onclick="() => HandlePinnedClickAsync(item.IsProject)">
                                <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                                <span class="pinned-icon" aria-hidden="true">
                                    @(item.IsProject ? "▣" : "●")
                                </span>
                                <span>@item.Title</span>
                            </a>

                            <details class="item-actions">
                                <summary aria-label="@Text("Actions", "Actions")">•••</summary>
                                <div class="item-action-menu">
                                    @if (itemIndex > 0)
                                    {
                                        <button type="button"
                                                disabled="@IsBusy"
                                                @onclick="() => ReorderPinAsync(item.PinId, itemIndex - 1)">
                                            @Text("Monter", "Move up")
                                        </button>
                                    }

                                    @if (itemIndex < PinnedItems.Count - 1)
                                    {
                                        <button type="button"
                                                disabled="@IsBusy"
                                                @onclick="() => ReorderPinAsync(item.PinId, itemIndex + 1)">
                                            @Text("Descendre", "Move down")
                                        </button>
                                    }

                                    <button type="button"
                                            disabled="@IsBusy"
                                            @onclick="() => SetPinAsync(item.TargetId, item.IsProject, false)">
                                        @Text("Désépingler", "Unpin")
                                    </button>
                                </div>
                            </details>
                        </div>
                    }

                    <div class="drop-zone"
                         @ondragover:preventDefault
                         @ondrop="() => DropPinAsync(PinnedItems.Count)">
                    </div>
                }
            </nav>
        </details>

        <details class="sidebar-section projects-section" open>
            <summary>
                <span>@Text("Projets", "Projects")</span>

                <span class="section-summary-controls">
                    <button id="projects-action-trigger"
                            class="menu-bubble"
                            type="button"
                            popovertarget="projects-action-menu"
                            aria-haspopup="menu"
                            aria-label="@Text("Actions des projets", "Project actions")"
                            @onpointerdown:stopPropagation
                            @onclick:stopPropagation>
                        <span aria-hidden="true">•••</span>
                    </button>

                    <span class="section-count">@Projects.Count</span>
                </span>
            </summary>

            <div class="section-content project-list">
                @if (Projects.Count == 0)
                {
                    <p class="section-empty">
                        @Text(
                            "Aucun projet. Créez-en un pour classer vos discussions.",
                            "No projects yet. Create one to organize your chats.")
                    </p>
                }

                @for (var projectIndex = 0;
                      projectIndex < Projects.Count;
                      projectIndex++)
                {
                    var project = Projects[projectIndex];
                    var currentProjectIndex = projectIndex;
                    var projectMenuId =
                        $"project-action-menu-{project.Id:N}-{currentProjectIndex}";
                    var projectAnchorName =
                        $"--project-action-trigger-{project.Id:N}-{currentProjectIndex}";
                    var projectTriggerStyle =
                        $"anchor-name: {projectAnchorName};";
                    var projectMenuStyle =
                        $"position-anchor: {projectAnchorName};";
                    var projectActionsLabel =
                        $"{Text("Actions du projet", "Project actions")}: {project.Name}";

                    <div class="project-row"
                         draggable="@(!IsBusy ? "true" : "false")"
                         @ondragstart="() => BeginProjectDrag(project.Id)"
                         @ondragend="ClearDrag"
                         @ondragover:preventDefault
                         @ondrop="() => DropProjectAsync(currentProjectIndex)">
                        <details id="@project.AnchorId"
                                 class="sidebar-project"
                                 open>
                            <summary>
                                <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                                <span class="project-name">@project.Name</span>

                                <span class="project-summary-controls">
                                    <button class="menu-bubble project-menu-trigger"
                                            type="button"
                                            style="@projectTriggerStyle"
                                            popovertarget="@projectMenuId"
                                            aria-haspopup="menu"
                                            aria-label="@projectActionsLabel"
                                            @onpointerdown:stopPropagation
                                            @onclick:stopPropagation>
                                        <span aria-hidden="true">•••</span>
                                    </button>

                                    <span class="project-count section-count">
                                        @project.Conversations.Count
                                    </span>
                                </span>
                            </summary>

                            <nav class="project-conversations"
                                 aria-label="@project.Name"
                                 @ondragover:preventDefault
                                 @ondrop="() => DropConversationAsync(project.Id, project.Conversations.Count)">
                                @if (project.Conversations.Count == 0)
                                {
                                    <p class="project-empty">
                                        @Text(
                                            "Déposez une discussion ici.",
                                            "Drop a chat here.")
                                    </p>
                                }
                                else
                                {
                                    @for (var conversationIndex = 0;
                                          conversationIndex < project.Conversations.Count;
                                          conversationIndex++)
                                    {
                                        var conversation = project.Conversations[conversationIndex];
                                        var currentConversationIndex = conversationIndex;

                                        <div class="sidebar-item-row conversation-row"
                                             draggable="@(!IsBusy ? "true" : "false")"
                                             @ondragstart="() => BeginConversationDrag(conversation.Id)"
                                             @ondragstart:stopPropagation
                                             @ondragend="ClearDrag"
                                             @ondragover:preventDefault
                                             @ondrop="() => DropConversationAsync(project.Id, currentConversationIndex)"
                                             @ondrop:stopPropagation>
                                            <a class="conversation-link nested @(conversation.IsActive ? "active" : null)"
                                               href="@conversation.Url"
                                               aria-current="@(conversation.IsActive ? "page" : null)"
                                               @onclick="CloseAsync">
                                                <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                                                <span class="conversation-bullet" aria-hidden="true"></span>
                                                <span>@conversation.Title</span>
                                            </a>

                                            <details class="item-actions">
                                                <summary aria-label="@Text("Actions", "Actions")">•••</summary>
                                                <div class="item-action-menu">
                                                    <button type="button"
                                                            disabled="@IsBusy"
                                                            @onclick="() => SetPinAsync(conversation.Id, false, !conversation.IsPinned)">
                                                        @(conversation.IsPinned
                                                            ? Text("Désépingler", "Unpin")
                                                            : Text("Épingler", "Pin"))
                                                    </button>

                                                    <button type="button"
                                                            disabled="@IsBusy"
                                                            @onclick="() => OpenRenameDialog(conversation.Id, false, conversation.Title)">
                                                        @Text("Renommer", "Rename")
                                                    </button>

                                                    @if (HasAlternativeDestination(conversation.ProjectId))
                                                    {
                                                        <button type="button"
                                                                disabled="@IsBusy"
                                                                @onclick="() => OpenMoveDialog(conversation)">
                                                            @Text("Déplacer…", "Move…")
                                                        </button>
                                                    }

                                                    @if (currentConversationIndex > 0)
                                                    {
                                                        <button type="button"
                                                                disabled="@IsBusy"
                                                                @onclick="() => MoveConversationAsync(conversation.Id, project.Id, currentConversationIndex - 1)">
                                                            @Text("Monter", "Move up")
                                                        </button>
                                                    }

                                                    @if (currentConversationIndex < project.Conversations.Count - 1)
                                                    {
                                                        <button type="button"
                                                                disabled="@IsBusy"
                                                                @onclick="() => MoveConversationAsync(conversation.Id, project.Id, currentConversationIndex + 1)">
                                                            @Text("Descendre", "Move down")
                                                        </button>
                                                    }

                                                    <button class="danger-action"
                                                            type="button"
                                                            disabled="@IsBusy"
                                                            @onclick="() => OpenDeleteDialog(conversation.Id, false, conversation.Title)">
                                                        @Text("Supprimer", "Delete")
                                                    </button>
                                                </div>
                                            </details>
                                        </div>
                                    }
                                }
                            </nav>
                        </details>

                        <div id="@projectMenuId"
                             class="sidebar-action-popover"
                             style="@projectMenuStyle"
                             popover="auto"
                             role="menu"
                             aria-label="@projectActionsLabel">
                            <button type="button"
                                    role="menuitem"
                                    disabled="@IsBusy"
                                    popovertarget="@projectMenuId"
                                    popovertargetaction="hide"
                                    @onclick="() => SetPinAsync(project.Id, true, !project.IsPinned)">
                                @(project.IsPinned
                                    ? Text("Désépingler", "Unpin")
                                    : Text("Épingler", "Pin"))
                            </button>

                            <button type="button"
                                    role="menuitem"
                                    disabled="@IsBusy"
                                    popovertarget="@projectMenuId"
                                    popovertargetaction="hide"
                                    @onclick="() => OpenRenameDialog(project.Id, true, project.Name)">
                                @Text("Renommer", "Rename")
                            </button>

                            <button class="danger-action"
                                    type="button"
                                    role="menuitem"
                                    disabled="@IsBusy"
                                    popovertarget="@projectMenuId"
                                    popovertargetaction="hide"
                                    @onclick="() => OpenDeleteDialog(project.Id, true, project.Name)">
                                @Text("Supprimer", "Delete")
                            </button>
                        </div>
                    </div>
                }

                <div class="drop-zone"
                     @ondragover:preventDefault
                     @ondrop="() => DropProjectAsync(Projects.Count)">
                </div>
            </div>
        </details>

        <div id="projects-action-menu"
             class="sidebar-action-popover"
             popover="auto"
             role="menu"
             aria-label="@Text("Actions des projets", "Project actions")">
            <button type="button"
                    role="menuitem"
                    disabled="@IsBusy"
                    popovertarget="projects-action-menu"
                    popovertargetaction="hide"
                    @onclick="OpenCreateProjectDialog">
                @Text("Nouveau projet", "New project")
            </button>
        </div>

        <details class="sidebar-section" open>
            <summary>
                <span>@Text("Discussions", "Chats")</span>
                <span class="section-count">@Conversations.Count</span>
            </summary>

            <nav class="section-content conversation-list"
                 aria-label="@Text("Discussions", "Chats")"
                 @ondragover:preventDefault
                 @ondrop="() => DropConversationAsync(null, Conversations.Count)">
                @if (Conversations.Count == 0)
                {
                    <p class="section-empty">
                        @Text(
                            "Aucune discussion non classée.",
                            "No unassigned chats.")
                    </p>
                }
                else
                {
                    @for (var conversationIndex = 0;
                          conversationIndex < Conversations.Count;
                          conversationIndex++)
                    {
                        var conversation = Conversations[conversationIndex];
                        var currentConversationIndex = conversationIndex;

                        <div class="sidebar-item-row conversation-row"
                             draggable="@(!IsBusy ? "true" : "false")"
                             @ondragstart="() => BeginConversationDrag(conversation.Id)"
                             @ondragend="ClearDrag"
                             @ondragover:preventDefault
                             @ondrop="() => DropConversationAsync(null, currentConversationIndex)">
                            <a class="conversation-link @(conversation.IsActive ? "active" : null)"
                               href="@conversation.Url"
                               aria-current="@(conversation.IsActive ? "page" : null)"
                               @onclick="CloseAsync">
                                <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                                <span class="conversation-bullet" aria-hidden="true"></span>
                                <span>@conversation.Title</span>
                            </a>

                            <details class="item-actions">
                                <summary aria-label="@Text("Actions", "Actions")">•••</summary>
                                <div class="item-action-menu">
                                    <button type="button"
                                            disabled="@IsBusy"
                                            @onclick="() => SetPinAsync(conversation.Id, false, !conversation.IsPinned)">
                                        @(conversation.IsPinned
                                            ? Text("Désépingler", "Unpin")
                                            : Text("Épingler", "Pin"))
                                    </button>

                                    <button type="button"
                                            disabled="@IsBusy"
                                            @onclick="() => OpenRenameDialog(conversation.Id, false, conversation.Title)">
                                        @Text("Renommer", "Rename")
                                    </button>

                                    @if (HasAlternativeDestination(conversation.ProjectId))
                                    {
                                        <button type="button"
                                                disabled="@IsBusy"
                                                @onclick="() => OpenMoveDialog(conversation)">
                                            @Text("Déplacer…", "Move…")
                                        </button>
                                    }

                                    @if (currentConversationIndex > 0)
                                    {
                                        <button type="button"
                                                disabled="@IsBusy"
                                                @onclick="() => MoveConversationAsync(conversation.Id, null, currentConversationIndex - 1)">
                                            @Text("Monter", "Move up")
                                        </button>
                                    }

                                    @if (currentConversationIndex < Conversations.Count - 1)
                                    {
                                        <button type="button"
                                                disabled="@IsBusy"
                                                @onclick="() => MoveConversationAsync(conversation.Id, null, currentConversationIndex + 1)">
                                            @Text("Descendre", "Move down")
                                        </button>
                                    }

                                    <button class="danger-action"
                                            type="button"
                                            disabled="@IsBusy"
                                            @onclick="() => OpenDeleteDialog(conversation.Id, false, conversation.Title)">
                                        @Text("Supprimer", "Delete")
                                    </button>
                                </div>
                            </details>
                        </div>
                    }
                }
            </nav>
        </details>

        @if (DeletedConversations.Count > 0)
        {
            <details class="sidebar-section trash-section">
                <summary>
                    <span>@Text("Corbeille", "Trash")</span>
                    <span class="section-count">@DeletedConversations.Count</span>
                </summary>

                <div class="section-content deleted-list">
                    @foreach (var conversation in DeletedConversations)
                    {
                        <div class="deleted-row">
                            <span title="@conversation.Title">@conversation.Title</span>
                            <button type="button"
                                    disabled="@IsBusy"
                                    @onclick="() => RestoreConversationAsync(conversation.Id)">
                                @Text("Restaurer", "Restore")
                            </button>
                        </div>
                    }
                </div>
            </details>
        }
    </div>

    <footer class="account-zone">
        <button class="account-trigger"
                type="button"
                popovertarget="local-account-menu"
                aria-haspopup="dialog"
                aria-label="@Text("Ouvrir le menu du compte", "Open account menu")">
            <span class="account-avatar" aria-hidden="true">A</span>
            <span class="account-copy">
                <strong>@Text("Compte local", "Local account")</strong>
                <small>@Text("Profil de démonstration", "Demo profile")</small>
            </span>
            <svg class="account-trigger-chevron"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="m8 14 4-4 4 4" />
            </svg>
        </button>

        <div id="local-account-menu"
             class="account-menu-popover"
             popover="auto"
             role="dialog"
             aria-label="@Text("Menu du compte", "Account menu")">
            <div class="account-menu-identity">
                <span class="account-avatar" aria-hidden="true">A</span>
                <span class="account-copy">
                    <strong>@Text("Compte local", "Local account")</strong>
                    <small>@Text("Profil de démonstration", "Demo profile")</small>
                </span>
                <span class="account-local-badge">
                    @Text("Local", "Local")
                </span>
            </div>

            <div class="account-menu-separator" role="separator"></div>

            <a class="account-menu-item"
               href="/settings"
               @onclick="CloseAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.09a2 2 0 0 1 1 1.74v.5a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2Z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                <span>@Text("Paramètres", "Settings")</span>
            </a>
        </div>
    </footer>
</aside>

@if (_dialogKind != SidebarDialogKind.None)
{
    <div class="management-dialog-backdrop" @onclick="CloseDialog">
        <section class="management-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="sidebar-dialog-title"
                 tabindex="-1"
                 @onclick:stopPropagation
                 @onkeydown="HandleDialogKeyDown"
                 @onkeydown:stopPropagation>
            <header>
                <h2 id="sidebar-dialog-title">@GetDialogTitle()</h2>
                <button type="button"
                        aria-label="@Text("Fermer", "Close")"
                        @onclick="CloseDialog">
                    ×
                </button>
            </header>

            @if (_dialogKind is SidebarDialogKind.CreateProject or
                 SidebarDialogKind.Rename)
            {
                <label for="sidebar-dialog-text">
                    @(_dialogKind == SidebarDialogKind.CreateProject
                        ? Text("Nom du projet", "Project name")
                        : Text("Nouveau nom", "New name"))
                </label>

                <input id="sidebar-dialog-text"
                       type="text"
                       maxlength="@(_dialogTargetIsProject ? 120 : 200)"
                       disabled="@IsBusy"
                       autofocus
                       @bind="_dialogText" />

                <div class="dialog-actions">
                    <button type="button" @onclick="CloseDialog">
                        @Text("Annuler", "Cancel")
                    </button>

                    <button class="primary-action"
                            type="button"
                            disabled="@(IsBusy || string.IsNullOrWhiteSpace(_dialogText))"
                            @onclick="SubmitTextDialogAsync">
                        @Text("Enregistrer", "Save")
                    </button>
                </div>
            }
            else if (_dialogKind == SidebarDialogKind.MoveConversation)
            {
                <label for="sidebar-dialog-project">
                    @Text("Destination", "Destination")
                </label>

                <select id="sidebar-dialog-project"
                        disabled="@IsBusy"
                        @bind="_dialogDestination">
                    @if (_dialogSourceProjectId is not null)
                    {
                        <option value="">@Text("Discussions", "Chats")</option>
                    }

                    @foreach (var project in Projects.Where(
                                  project => project.Id != _dialogSourceProjectId))
                    {
                        <option value="@(project.Id.ToString("D"))">
                            @project.Name
                        </option>
                    }
                </select>

                <div class="dialog-actions">
                    <button type="button" @onclick="CloseDialog">
                        @Text("Annuler", "Cancel")
                    </button>

                    <button class="primary-action"
                            type="button"
                            disabled="@IsBusy"
                            @onclick="SubmitMoveDialogAsync">
                        @Text("Déplacer", "Move")
                    </button>
                </div>
            }
            else if (_dialogKind == SidebarDialogKind.Delete)
            {
                <p>
                    @(_dialogTargetIsProject
                        ? Text(
                            "Les discussions du projet seront replacées dans Discussions. Aucune discussion ne sera supprimée.",
                            "The project's chats will return to Chats. No chat will be deleted.")
                        : Text(
                            "La discussion sera placée dans la Corbeille et pourra être restaurée.",
                            "The chat will be moved to Trash and can be restored."))
                </p>

                <strong class="dialog-target">@_dialogText</strong>

                <div class="dialog-actions">
                    <button type="button" @onclick="CloseDialog">
                        @Text("Annuler", "Cancel")
                    </button>

                    <button class="danger-confirm"
                            type="button"
                            disabled="@IsBusy"
                            @onclick="SubmitDeleteDialogAsync">
                        @Text("Confirmer la suppression", "Confirm deletion")
                    </button>
                </div>
            }
        </section>
    </div>
}
