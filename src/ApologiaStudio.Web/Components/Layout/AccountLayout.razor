@inherits LayoutComponentBase
@using ApologiaStudio.Domain.Users
@using ApologiaStudio.Web.Identity
@inject IHttpContextAccessor HttpContextAccessor

<CascadingValue Value="_interfaceLanguage" IsFixed="true">
    <main class="account-shell">
        <a class="account-brand" href="/">
            <span aria-hidden="true">A</span>
            <strong>Apologia Studio</strong>
        </a>

        <section class="account-card">
            @Body
        </section>
    </main>
</CascadingValue>

@code {
    private ApplicationLanguage _interfaceLanguage;

    protected override void OnInitialized() =>
        _interfaceLanguage = InterfaceLanguageCookie.Read(
            HttpContextAccessor.HttpContext);
}
