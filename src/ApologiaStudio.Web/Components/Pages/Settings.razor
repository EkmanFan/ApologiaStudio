@page "/settings"
@attribute [Authorize(Policy = SystemPermissions.ManageSettings)]

@using Microsoft.Extensions.DependencyInjection
@using ApologiaStudio.Application.Preferences
@using ApologiaStudio.Domain.Users

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IServiceScopeFactory ServiceScopeFactory

<PageTitle>@Text("Préférences", "Preferences") · Apologia Studio</PageTitle>
<DocumentLanguage Language="@SelectedInterfaceLanguage" />

<main class="settings-shell">
    <header class="settings-header">
        <div>
            <p class="settings-eyebrow">Apologia Studio</p>
            <h1>@Text("Préférences", "Preferences")</h1>
            <p>
                @Text(
                    "Configurez l’application, le runtime d’IA et les profils des agents.",
                    "Configure the application, AI runtime, and agent profiles.")
            </p>
        </div>
        <a href="/">
            @Text("Retour aux conversations", "Back to conversations")
        </a>
    </header>

    <nav class="settings-tabs"
         role="tablist"
         aria-label="@Text("Catégories de préférences", "Settings categories")">
        <button id="settings-tab-general"
                type="button"
                role="tab"
                aria-selected="@(_activeTab == SettingsTab.General)"
                aria-controls="settings-panel-general"
                class="@TabClass(SettingsTab.General)"
                @onclick="() => SelectTab(SettingsTab.General)">
            @Text("Général", "General")
        </button>
        <button id="settings-tab-ai"
                type="button"
                role="tab"
                aria-selected="@(_activeTab == SettingsTab.Ai)"
                aria-controls="settings-panel-ai"
                class="@TabClass(SettingsTab.Ai)"
                @onclick="() => SelectTab(SettingsTab.Ai)">
            @Text("IA", "AI")
        </button>
        <button id="settings-tab-agents"
                type="button"
                role="tab"
                aria-selected="@(_activeTab == SettingsTab.Agents)"
                aria-controls="settings-panel-agents"
                class="@TabClass(SettingsTab.Agents)"
                @onclick="() => SelectTab(SettingsTab.Agents)">
            @Text("Agents", "Agents")
        </button>
    </nav>

    <section id="settings-panel-general"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-general"
             hidden="@(_activeTab != SettingsTab.General)">
        @if (_isLoading)
        {
            <p class="settings-status">
                @Text("Chargement des préférences…", "Loading preferences…")
            </p>
        }
        else
        {
            <section class="settings-card"
                     aria-labelledby="general-settings-title">
                <header class="panel-heading">
                    <div>
                        <p class="settings-eyebrow">
                            @Text("Application", "Application")
                        </p>
                        <h2 id="general-settings-title">
                            @Text("Paramètres généraux", "General settings")
                        </h2>
                    </div>
                    <p>
                        @Text(
                            "Langues, saisie et affichage des conversations.",
                            "Languages, input, and conversation display.")
                    </p>
                </header>

                <div class="settings-field">
                    <label for="interface-language">
                        @Text("Langue de l’IHM", "Interface language")
                    </label>
                    <select id="interface-language"
                            @bind="_interfaceLanguageCode"
                            disabled="@_isSaving">
                        <option value="fr">Français</option>
                        <option value="en">English</option>
                    </select>
                    <p>
                        @Text(
                            "Détermine la langue des menus, boutons et messages de l’application.",
                            "Controls the language of application menus, buttons, and messages.")
                    </p>
                </div>

                <div class="settings-field">
                    <label for="theological-language">
                        @Text(
                            "Langue biblique et théologique",
                            "Bible and theological language")
                    </label>
                    <select id="theological-language"
                            @bind="_theologicalLanguageCode"
                            disabled="@_isSaving">
                        <option value="">
                            @Text(
                                "Identique à la langue de l’IHM",
                                "Same as interface language")
                        </option>
                        <option value="fr">Français</option>
                        <option value="en">English</option>
                    </select>
                    <p>
                        @Text(
                            "Utilisée par défaut pour les réponses théologiques et les textes bibliques. Une langue demandée explicitement dans un message reste prioritaire.",
                            "Used by default for theological answers and Bible text. A language explicitly requested in a message still takes priority.")
                    </p>
                </div>

                <div class="settings-field">
                    <label for="composer-enter-behavior">
                        @Text(
                            "Comportement de la touche Entrée",
                            "Enter key behavior")
                    </label>
                    <select id="composer-enter-behavior"
                            @bind="_composerEnterBehavior"
                            disabled="@_isSaving">
                        <option value="@ComposerEnterBehavior.NewLine">
                            @Text(
                                "Entrée ajoute une nouvelle ligne",
                                "Enter inserts a new line")
                        </option>
                        <option value="@ComposerEnterBehavior.SendMessage">
                            @Text(
                                "Entrée envoie le message",
                                "Enter sends the message")
                        </option>
                    </select>
                    <p>
                        @Text(
                            "Lorsque Entrée envoie le message, Ctrl+Entrée ajoute une nouvelle ligne.",
                            "When Enter sends the message, Ctrl+Enter inserts a new line.")
                    </p>
                </div>
                <div class="settings-field">
                    <label for="message-date-format">
                        @Text("Format de date", "Date format")
                    </label>
                    <select id="message-date-format"
                            @bind="_messageDateFormat"
                            disabled="@_isSaving">
                        <option value="@MessageTimestampFormats.DayMonthYear">
                            @Text("JJ/MM/YYYY — 23/08/2026", "DD/MM/YYYY — 23/08/2026")
                        </option>
                        <option value="@MessageTimestampFormats.MonthDayYear">
                            @Text("MM/JJ/YYYY — 08/23/2026", "MM/DD/YYYY — 08/23/2026")
                        </option>
                        <option value="@MessageTimestampFormats.IsoYearMonthDay">
                            YYYY-MM-DD — 2026-08-23
                        </option>
                    </select>
                    <p>
                        @Text(
                            "Format de la date affichée dans les bulles de messages.",
                            "Date format displayed in conversation message bubbles.")
                    </p>
                </div>
                <div class="settings-field">
                    <label for="message-time-format">
                        @Text("Format de l’heure", "Time format")
                    </label>
                    <select id="message-time-format"
                            @bind="_messageTimeFormat"
                            disabled="@_isSaving">
                        <option value="@MessageTimestampFormats.TwentyFourHourWithSeconds">
                            HH:mm:ss — 23:45:38
                        </option>
                        <option value="@MessageTimestampFormats.TwentyFourHour">
                            HH:mm — 23:45
                        </option>
                        <option value="@MessageTimestampFormats.TwelveHourWithSeconds">
                            hh:mm:ss tt — 11:45:38 PM
                        </option>
                        <option value="@MessageTimestampFormats.TwelveHour">
                            hh:mm tt — 11:45 PM
                        </option>
                    </select>
                    <p>
                        @Text(
                            "Format de l’heure affichée dans les bulles de messages.",
                            "Time format displayed in conversation message bubbles.")
                    </p>
                </div>
                <div class="effective-language">
                    <span>
                        @Text(
                            "Langue biblique et théologique effective",
                            "Effective Bible and theological language")
                    </span>
                    <strong>@EffectiveTheologicalLanguageLabel</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <p class="settings-status success">
                        @_statusMessage
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <p class="settings-status error">
                        @_errorMessage
                    </p>
                }

                <button type="button"
                        disabled="@_isSaving"
                        @onclick="SaveAsync">
                    @(_isSaving
                        ? Text("Enregistrement…", "Saving…")
                        : Text("Enregistrer", "Save"))
                </button>
            </section>
        }
    </section>

    <section id="settings-panel-ai"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-ai"
             hidden="@(_activeTab != SettingsTab.Ai)">
        <OllamaRuntimeSettingsPanel />
    </section>

    <section id="settings-panel-agents"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-agents"
             hidden="@(_activeTab != SettingsTab.Agents)">
        <AgentSettingsPanel ActivationVersion="@_agentActivationVersion" />
    </section>
</main>
