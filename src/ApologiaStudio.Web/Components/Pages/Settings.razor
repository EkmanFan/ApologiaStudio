@page "/settings"
@attribute [Authorize(Policy = SystemPermissions.AccessStudio)]

@using Microsoft.Extensions.DependencyInjection
@using ApologiaStudio.Application.Preferences
@using ApologiaStudio.Domain.Users

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IServiceScopeFactory ServiceScopeFactory
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation

<PageTitle>@Text("Préférences", "Preferences") · Apologia Studio</PageTitle>
<DocumentLanguage Language="@SelectedInterfaceLanguage" />

<main class="settings-shell">
    <section class="settings-page-header">
        <header class="settings-header">
            <div>
                <p class="settings-eyebrow">Apologia Studio</p>
                <h1>@Text("Préférences", "Preferences")</h1>
                <p>
                    @Text(
                        "Personnalisez la langue, les dates et le comportement de votre espace.",
                        "Customize the language, dates, and behavior of your workspace.")
                </p>
            </div>
            <button class="settings-close"
                    type="button"
                    aria-label="@Text("Fermer et revenir à Apologia Studio", "Close and return to Apologia Studio")"
                    title="@Text("Fermer sans enregistrer les modifications", "Close without saving changes")"
                    @onclick="CloseAsync">×</button>
        </header>

        <nav class="settings-tabs"
             role="tablist"
             aria-label="@Text("Catégories de préférences", "Preference categories")">
            <button id="settings-tab-languages"
                    type="button"
                    role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Languages)"
                    aria-controls="settings-panel-languages"
                    class="@TabClass(SettingsTab.Languages)"
                    @onclick="() => SelectTab(SettingsTab.Languages)">
                @Text("Langues", "Languages")
            </button>
            <button id="settings-tab-dates"
                    type="button"
                    role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Dates)"
                    aria-controls="settings-panel-dates"
                    class="@TabClass(SettingsTab.Dates)"
                    @onclick="() => SelectTab(SettingsTab.Dates)">
                @Text("Dates", "Dates")
            </button>
            <button id="settings-tab-behavior"
                    type="button"
                    role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Behavior)"
                    aria-controls="settings-panel-behavior"
                    class="@TabClass(SettingsTab.Behavior)"
                    @onclick="() => SelectTab(SettingsTab.Behavior)">
                @Text("Comportement", "Behavior")
            </button>
            <button id="settings-tab-themes"
                    type="button"
                    role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Themes)"
                    aria-controls="settings-panel-themes"
                    class="@TabClass(SettingsTab.Themes)"
                    @onclick="() => SelectTab(SettingsTab.Themes)">
                @Text("Thèmes", "Themes")
            </button>
            <button id="settings-tab-landing-page"
                    type="button"
                    role="tab"
                    aria-selected="@(_activeTab == SettingsTab.LandingPage)"
                    aria-controls="settings-panel-landing-page"
                    class="@TabClass(SettingsTab.LandingPage)"
                    @onclick="() => SelectTab(SettingsTab.LandingPage)">
                @Text("Page d’accueil", "Landing page")
            </button>
        </nav>

        <ActionRibbon AriaLabel="@Text("Actions des préférences", "Preference actions")">
            <ActionRibbonGroup Label="@Text("Modifications", "Changes")">
                <button class="action-ribbon-command primary"
                        type="button"
                        disabled="@(_isLoading || _isSaving || !ActiveTabCanBeSaved)"
                        title="@SaveButtonTitle"
                        @onclick="SaveAsync">
                    @(_isSaving ? Text("Enregistrement…", "Saving…") : Text("Enregistrer", "Save"))
                </button>
                @if (_activeTab == SettingsTab.Themes)
                {
                    <button class="action-ribbon-command"
                            type="button"
                            disabled="@(_isLoading || _isSaving || IsDefaultTheme)"
                            title="@Text("Rétablir le thème par défaut", "Restore the default theme")"
                            @onclick="ResetThemeAsync">
                        @Text("Réinitialiser", "Reset")
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <span class="action-ribbon-note success" role="status">@_statusMessage</span>
                }
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <span class="action-ribbon-note error" role="alert">@_errorMessage</span>
                }
            </ActionRibbonGroup>
        </ActionRibbon>
    </section>

    <section id="settings-panel-languages"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-languages"
             hidden="@(_activeTab != SettingsTab.Languages)">
        @if (_isLoading)
        {
            <p class="settings-status">
                @Text("Chargement des préférences…", "Loading preferences…")
            </p>
        }
        else
        {
            <section class="settings-card"
                     aria-labelledby="languages-settings-title">
                <header class="panel-heading">
                    <div>
                        <p class="settings-eyebrow">
                            @Text("Langues", "Languages")
                        </p>
                        <h2 id="languages-settings-title">
                            @Text("Langues de votre espace", "Workspace languages")
                        </h2>
                    </div>
                    <p>
                        @Text(
                            "Choisissez la langue de l’interface et celle utilisée par défaut pour la Bible et les réponses théologiques.",
                            "Choose the interface language and the default language for Bible content and theological answers.")
                    </p>
                </header>

                <div class="settings-field">
                    <label for="interface-language">
                        @Text("Langue de l’IHM", "Interface language")
                    </label>
                    <select id="interface-language"
                            @bind="_interfaceLanguageCode"
                            disabled="@_isSaving">
                        <option value="fr">Français</option>
                        <option value="en">English</option>
                    </select>
                    <p>
                        @Text(
                            "Détermine la langue des menus, boutons et messages de l’application.",
                            "Controls the language of application menus, buttons, and messages.")
                    </p>
                </div>

                <div class="settings-field">
                    <label for="theological-language">
                        @Text(
                            "Langue biblique et théologique",
                            "Bible and theological language")
                    </label>
                    <select id="theological-language"
                            @bind="_theologicalLanguageCode"
                            disabled="@_isSaving">
                        <option value="">
                            @Text(
                                "Identique à la langue de l’IHM",
                                "Same as interface language")
                        </option>
                        <option value="fr">Français</option>
                        <option value="en">English</option>
                    </select>
                    <p>
                        @Text(
                            "Utilisée par défaut pour les réponses théologiques et les textes bibliques. Une langue demandée explicitement dans un message reste prioritaire.",
                            "Used by default for theological answers and Bible text. A language explicitly requested in a message still takes priority.")
                    </p>
                </div>

                <div class="effective-language">
                    <span>
                        @Text(
                            "Langue biblique et théologique effective",
                            "Effective Bible and theological language")
                    </span>
                    <strong>@EffectiveTheologicalLanguageLabel</strong>
                </div>

            </section>
        }
    </section>

    <section id="settings-panel-dates"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-dates"
             hidden="@(_activeTab != SettingsTab.Dates)">
        <section class="settings-card" aria-labelledby="dates-settings-title">
            <header class="panel-heading">
                <div>
                    <p class="settings-eyebrow">@Text("Dates", "Dates")</p>
                    <h2 id="dates-settings-title">@Text("Date et heure", "Date and time")</h2>
                </div>
                <p>@Text("Adaptez les horodatages des conversations à vos habitudes.", "Adapt conversation timestamps to your preferences.")</p>
            </header>

            <div class="settings-field">
                <label for="message-date-format">@Text("Format de date", "Date format")</label>
                <select id="message-date-format" @bind="_messageDateFormat" disabled="@(_isLoading || _isSaving)">
                    <option value="@MessageTimestampFormats.DayMonthYear">@Text("JJ/MM/YYYY — 23/08/2026", "DD/MM/YYYY — 23/08/2026")</option>
                    <option value="@MessageTimestampFormats.MonthDayYear">@Text("MM/JJ/YYYY — 08/23/2026", "MM/DD/YYYY — 08/23/2026")</option>
                    <option value="@MessageTimestampFormats.IsoYearMonthDay">YYYY-MM-DD — 2026-08-23</option>
                </select>
                <p>@Text("Format de la date affichée dans les bulles de messages.", "Date format displayed in conversation message bubbles.")</p>
            </div>

            <div class="settings-field">
                <label for="message-time-format">@Text("Format de l’heure", "Time format")</label>
                <select id="message-time-format" @bind="_messageTimeFormat" disabled="@(_isLoading || _isSaving)">
                    <option value="@MessageTimestampFormats.TwentyFourHourWithSeconds">HH:mm:ss — 23:45:38</option>
                    <option value="@MessageTimestampFormats.TwentyFourHour">HH:mm — 23:45</option>
                    <option value="@MessageTimestampFormats.TwelveHourWithSeconds">hh:mm:ss tt — 11:45:38 PM</option>
                    <option value="@MessageTimestampFormats.TwelveHour">hh:mm tt — 11:45 PM</option>
                </select>
                <p>@Text("Format de l’heure affichée dans les bulles de messages.", "Time format displayed in conversation message bubbles.")</p>
            </div>
        </section>
    </section>

    <section id="settings-panel-behavior"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-behavior"
             hidden="@(_activeTab != SettingsTab.Behavior)">
        <section class="settings-card" aria-labelledby="behavior-settings-title">
            <header class="panel-heading">
                <div>
                    <p class="settings-eyebrow">@Text("Comportement", "Behavior")</p>
                    <h2 id="behavior-settings-title">@Text("Saisie des messages", "Message input")</h2>
                </div>
                <p>@Text("Choisissez ce que fait la touche Entrée dans le compositeur.", "Choose what the Enter key does in the composer.")</p>
            </header>

            <div class="settings-field">
                <label for="composer-enter-behavior">@Text("Comportement de la touche Entrée", "Enter key behavior")</label>
                <select id="composer-enter-behavior" @bind="_composerEnterBehavior" disabled="@(_isLoading || _isSaving)">
                    <option value="@ComposerEnterBehavior.NewLine">@Text("Entrée ajoute une nouvelle ligne", "Enter inserts a new line")</option>
                    <option value="@ComposerEnterBehavior.SendMessage">@Text("Entrée envoie le message", "Enter sends the message")</option>
                </select>
                <p>@Text("Lorsque Entrée envoie le message, Ctrl+Entrée ajoute une nouvelle ligne.", "When Enter sends the message, Ctrl+Enter inserts a new line.")</p>
            </div>
        </section>
    </section>

    <section id="settings-panel-themes"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-themes"
             hidden="@(_activeTab != SettingsTab.Themes)">
        <section class="settings-card" aria-labelledby="themes-settings-title">
            <header class="panel-heading">
                <div>
                    <p class="settings-eyebrow">@Text("Thèmes", "Themes")</p>
                    <h2 id="themes-settings-title">@Text("Apparence", "Appearance")</h2>
                </div>
                <p>@Text("Choisissez un mode d’affichage et la couleur principale de votre espace.", "Choose a display mode and the main color of your workspace.")</p>
            </header>

            <div class="theme-mode-setting">
                <div>
                    <strong id="theme-mode-label">@Text("Mode d’affichage", "Display mode")</strong>
                    <p>@Text("Le changement est visible immédiatement et sera conservé après enregistrement.", "The change is visible immediately and will be kept after saving.")</p>
                </div>
                <button type="button"
                        role="switch"
                        aria-labelledby="theme-mode-label"
                        aria-checked="@(_themeMode == ThemeMode.Dark)"
                        class="@ThemeToggleClass"
                        disabled="@(_isLoading || _isSaving)"
                        @onclick="ToggleThemeModeAsync">
                    <span class="theme-toggle-choice light-choice">
                        <span aria-hidden="true">☀</span>
                        @Text("Clair", "Light")
                    </span>
                    <span class="theme-toggle-choice dark-choice">
                        <span aria-hidden="true">☾</span>
                        @Text("Sombre", "Dark")
                    </span>
                </button>
            </div>

            <div class="theme-color-setting">
                <div class="theme-controls">
                    <div class="settings-field">
                        <label for="theme-color">@Text("Couleur principale", "Main color")</label>
                        <div class="theme-color-control">
                            <input id="theme-color"
                                   type="color"
                                   value="@_themeColor"
                                   disabled="@(_isLoading || _isSaving)"
                                   @oninput="UpdateThemeColor" />
                            <output for="theme-color">@_themeColor</output>
                        </div>
                        <p>@Text("Cette couleur personnalise les boutons, les sélections et les repères visuels.", "This color customizes buttons, selections, and visual accents.")</p>
                    </div>

                    <fieldset class="dark-palette-settings" disabled="@(_isLoading || _isSaving || _themeMode != ThemeMode.Dark)">
                        <legend>@Text("Palette du mode sombre", "Dark mode palette")</legend>
                        <div class="shade-setting">
                            <label for="dark-page-shade">@Text("Fond de l’écran", "Screen background")</label>
                            <div class="shade-control">
                                <input id="dark-page-shade"
                                       type="range"
                                       min="@UserPreferences.MinimumDarkShade"
                                       max="@UserPreferences.MaximumDarkShade"
                                       value="@DarkPageShade"
                                       @oninput="UpdateDarkPageShade" />
                                <span class="shade-swatch" style="background: @_darkPageColor" aria-hidden="true"></span>
                                <output for="dark-page-shade">@_darkPageColor</output>
                            </div>
                        </div>
                        <div class="shade-setting">
                            <label for="dark-surface-shade">@Text("Fond des zones de présentation", "Presentation area background")</label>
                            <div class="shade-control">
                                <input id="dark-surface-shade"
                                       type="range"
                                       min="@UserPreferences.MinimumDarkShade"
                                       max="@UserPreferences.MaximumDarkShade"
                                       value="@DarkSurfaceShade"
                                       @oninput="UpdateDarkSurfaceShade" />
                                <span class="shade-swatch" style="background: @_darkSurfaceColor" aria-hidden="true"></span>
                                <output for="dark-surface-shade">@_darkSurfaceColor</output>
                            </div>
                        </div>
                        <p>@Text("Un fond de présentation légèrement plus clair aide à distinguer les cartes et les panneaux.", "A slightly lighter presentation background helps distinguish cards and panels.")</p>
                    </fieldset>
                </div>

                <div class="@ThemePreviewClass" style="@ThemePreviewStyle" aria-label="@Text("Aperçu du thème", "Theme preview")">
                    <div class="theme-preview-surface">
                        <span class="theme-preview-eyebrow">Apologia Studio</span>
                        <strong>@Text("Aperçu du thème", "Theme preview")</strong>
                        <p>@Text("Le cadre représente l’écran et cette carte la zone de présentation.", "The frame represents the screen and this card the presentation area.")</p>
                        <span class="theme-preview-button">@Text("Action principale", "Primary action")</span>
                    </div>
                </div>
            </div>
        </section>
    </section>

    <section id="settings-panel-landing-page"
             class="settings-tab-panel"
             role="tabpanel"
             aria-labelledby="settings-tab-landing-page"
             hidden="@(_activeTab != SettingsTab.LandingPage)">
        <section class="settings-card future-settings" aria-labelledby="landing-page-settings-title">
            <header class="panel-heading">
                <div>
                    <p class="settings-eyebrow">@Text("Page d’accueil", "Landing page")</p>
                    <h2 id="landing-page-settings-title">@Text("Ouverture de Studio", "Opening Studio")</h2>
                </div>
                <p>@Text("Le choix de la page affichée à l’ouverture sera bientôt disponible ici.", "The choice of the page shown when Studio opens will soon be available here.")</p>
            </header>
            <p>@Text("Cet emplacement est prêt pour la future option de page d’accueil.", "This area is ready for the future landing-page option.")</p>
        </section>
    </section>

</main>
