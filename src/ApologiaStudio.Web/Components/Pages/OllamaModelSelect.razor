@using ApologiaStudio.AgentRuntime.Routing.Semantic

<select id="@Id"
        disabled="@(IsDisabled || Models.Count == 0)"
        value="@Value"
        @onchange="HandleChangedAsync">
    @if (HasUnavailableValue)
    {
        <option value="@Value">
            @Value — indisponible à cette adresse
        </option>
    }

    @foreach (var model in Models)
    {
        <option value="@model.Name">
            @model.DisplayName
        </option>
    }
</select>
