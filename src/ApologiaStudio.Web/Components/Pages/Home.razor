@page "/"
@page "/conversations/{ConversationIdValue:guid}"

@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.DependencyInjection
@using ApologiaStudio.Application.Agents
@using ApologiaStudio.Application.Agents.Settings
@using ApologiaStudio.Application.Abstractions.BibleCorpora
@using ApologiaStudio.Application.BibleCorpora.Queries
@using ApologiaStudio.Application.BibleCorpora.Reader
@using ApologiaStudio.Application.Conversations.CreateConversation
@using ApologiaStudio.Application.Conversations.DeleteConversation
@using ApologiaStudio.Application.Conversations.GetConversation
@using ApologiaStudio.Application.Conversations.ListConversations
@using ApologiaStudio.Application.Conversations.MoveConversation
@using ApologiaStudio.Application.Conversations.RenameConversation
@using ApologiaStudio.Application.Conversations.RestoreConversation
@using ApologiaStudio.Application.Conversations.SendMessage
@using ApologiaStudio.Application.Navigation.ReorderPinnedItems
@using ApologiaStudio.Application.Navigation.ReorderProjects
@using ApologiaStudio.Application.Navigation.SetSidebarPin
@using ApologiaStudio.Application.Preferences
@using ApologiaStudio.Application.Navigation.GetSidebarNavigation
@using ApologiaStudio.Application.Projects.CreateProject
@using ApologiaStudio.Application.Projects.DeleteProject
@using ApologiaStudio.Application.Projects.RenameProject
@using ApologiaStudio.Domain.Agents
@using ApologiaStudio.Domain.Conversations
@using ApologiaStudio.Domain.Navigation
@using ApologiaStudio.Domain.Projects
@using ApologiaStudio.Domain.Users
@using ApologiaStudio.Web.Components.Navigation

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IServiceScopeFactory ServiceScopeFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

<PageTitle>Apologia Studio</PageTitle>
<DocumentLanguage Language="@_interfaceLanguage" />

@if (_isLoading)
{
    <div class="loading">
        @Ui("Chargement des conversations…", "Loading conversations…")
    </div>
}
else
{
    <section class="studio-layout"
             @onkeydown="HandleShellKeyDown">
        <StudioSidebar BibleEditions="@GetSidebarBibleEditions()"
                       PinnedItems="@GetSidebarPinnedItems()"
                       Projects="@GetSidebarProjects()"
                       Conversations="@GetSidebarConversations()"
                       DeletedConversations="@GetSidebarDeletedConversations()"
                       Language="@_interfaceLanguage"
                       IsOpen="@_isSidebarOpen"
                       IsCreatingConversation="@(_isCreatingConversation || _isSending)"
                       IsBusy="@_isManagingSidebar"
                       OnClose="CloseSidebar"
                       OnCreateConversation="CreateConversationAsync"
                       OnCreateProject="CreateProjectAsync"
                       OnRename="RenameSidebarItemAsync"
                       OnSetPin="SetSidebarPinAsync"
                       OnMoveConversation="MoveConversationAsync"
                       OnReorderProjects="ReorderProjectsAsync"
                       OnReorderPinnedItems="ReorderPinnedItemsAsync"
                       OnDelete="DeleteSidebarItemAsync"
                       OnRestoreConversation="RestoreConversationAsync" />

        <section class="chat-shell">
            <button id="studio-sidebar-toggle"
                    class="mobile-sidebar-toggle"
                    type="button"
                    aria-controls="studio-sidebar"
                    aria-expanded="@(_isSidebarOpen ? "true" : "false")"
                    aria-label="@Ui("Ouvrir la navigation", "Open navigation")"
                    @onclick="OpenSidebar">
                <span aria-hidden="true">☰</span>
            </button>

            @if (_conversation is null)
            {
                <div class="missing-conversation">
                    <h1>
                        @Ui("Conversation introuvable", "Conversation not found")
                    </h1>

                    <p>
                        @Ui(
                            "Cette conversation n’existe pas ou ne vous appartient pas.",
                            "This conversation does not exist or does not belong to you.")
                    </p>

                    <button type="button"
                            @onclick="CreateConversationAsync">
                        @Ui("Créer une conversation", "Create a conversation")
                    </button>
                </div>
            }
            else
            {
                <header class="chat-header">
                    <div class="conversation-heading">
                        <div>
                            <h1>@_conversation.Title</h1>

                            <p>
                                @Ui(
                                    "Posez une question. Le spécialiste le plus pertinent sera sélectionné automatiquement.",
                                    "Ask a question. The most relevant specialist will be selected automatically.")
                            </p>
                        </div>

                        <div class="runtime-badge">
                            @Ui("Runtime local", "Local runtime")
                        </div>
                    </div>

                    <div class="rename-controls">
                        <input type="text"
                               maxlength="200"
                               disabled="@(_isRenaming || _isSending)"
                               @bind="_renameDraft"
                               aria-label="@ConversationTitleLabel" />

                        <button type="button"
                                disabled="@(_isRenaming ||
                                           _isSending ||
                                           string.IsNullOrWhiteSpace(
                                               _renameDraft) ||
                                           _renameDraft.Trim() ==
                                               _conversation.Title)"
                                @onclick="RenameConversationAsync">
                            @Ui("Renommer", "Rename")
                        </button>
                    </div>
                </header>

                <div class="thread-stage">
                    <main class="conversation-thread"
                          @ref="_conversationThread">
                        @if (_conversation.Messages.Count == 0 &&
                             string.IsNullOrEmpty(_streamingText))
                        {
                            <div class="empty-state">
                                <h2>
                                    @Ui("Commencez directement", "Start right away")
                                </h2>

                                <p>@Ui("Exemples :", "Examples:")</p>

                                <button type="button"
                                        @onclick="UseHistoricalSuggestion">
                                    @Ui("Question historique", "Historical question")
                                </button>

                                <button type="button"
                                        @onclick="UseApologeticSuggestion">
                                    @Ui("Question apologétique", "Apologetics question")
                                </button>
                            </div>
                        }

                        @foreach (var message in _conversation.Messages)
                        {
                            <article class="@GetMessageCssClass(message)"
                                     style="@GetMessageStyle(message)">
                                @if (message.Role == MessageRole.Agent &&
                                     message.AgentId is { } messageAgentId)
                                {
                                    <div class="message-avatar"
                                         aria-hidden="true">
                                        @GetAgentAvatar(messageAgentId)
                                    </div>
                                }

                                <div class="message-body">
                                    <div class="message-author">
                                        @GetMessageAuthor(message)
                                    </div>

                                    <div class="message-content">
                                        @message.Content
                                    </div>
                                </div>
                            </article>
                        }

                        @if (!string.IsNullOrEmpty(_streamingText))
                        {
                            <article class="message agent streaming"
                                     style="@GetAgentStyle(_activeAgentId)">
                                <div class="message-avatar"
                                     aria-hidden="true">
                                    @GetAgentAvatar(_activeAgentId)
                                </div>

                                <div class="message-body">
                                    <div class="message-author">
                                        @(_activeAgentName ?? "Agent")
                                    </div>

                                    <div class="message-content">
                                        @_streamingText
                                        <span class="cursor">▋</span>
                                    </div>
                                </div>
                            </article>
                        }
                    </main>

                    @if (_showJumpToLatest)
                    {
                        <button class="jump-to-latest"
                                type="button"
                                @onclick="JumpToLatestAsync">
                            <span aria-hidden="true">↓</span>
                            @Ui("Dernier message", "Latest message")
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_routingReason) ||
                     !string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="chat-feedback">
                        @if (!string.IsNullOrWhiteSpace(_routingReason))
                        {
                            <aside class="routing-information">
                                <strong>@Ui("Routage :", "Routing:")</strong>
                                @_routingReason
                            </aside>
                        }

                        @if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <aside class="error-information">
                                @_errorMessage
                            </aside>
                        }
                    </div>
                }

                <footer class="composer">
                    <div class="composer-surface">
                        <div class="composer-options">
                            <label for="agent-selection">
                                @Ui("Expert", "Specialist")
                            </label>

                            <select id="agent-selection"
                                    @bind="_selectedAgentSlug"
                                    disabled="@_isSending">
                                <option value="">
                                    @Ui("Routage automatique", "Automatic routing")
                                </option>

                                @foreach (var settings in _agentSettings.Values
                                    .Where(candidate => candidate.IsEnabled)
                                    .OrderByDescending(candidate => candidate.IsBuiltIn)
                                    .ThenBy(candidate => candidate.DisplayName))
                                {
                                    <option value="@settings.Slug">
                                        @settings.DisplayName
                                    </option>
                                }
                            </select>
                        </div>

                        <textarea @ref="_composerTextArea"
                                  @bind="_draft"
                                  @bind:event="oninput"
                                  disabled="@_isSending"
                                  maxlength="50000"
                                  rows="4"
                                  placeholder="@QuestionPlaceholder">
                        </textarea>

                        <div class="composer-actions">
                            <span>
                                @(_isSending
                                    ? Ui("Réponse en cours…", "Generating response…")
                                    : Ui(
                                        "Routage automatique ou sélection manuelle.",
                                        "Automatic routing or manual selection."))
                            </span>

                            <button type="button"
                                    @ref="_composerSendButton"
                                    disabled="@(_isSending ||
                                               string.IsNullOrWhiteSpace(
                                                   _draft))"
                                    @onclick="SendAsync">
                                @Ui("Envoyer", "Send")
                            </button>
                        </div>
                    </div>
                </footer>
            }
            </section>
    </section>
}
