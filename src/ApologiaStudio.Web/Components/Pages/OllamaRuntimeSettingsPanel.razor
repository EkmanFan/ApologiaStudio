@rendermode InteractiveServer
@using Microsoft.Extensions.DependencyInjection
@using ApologiaStudio.AgentRuntime.Routing.Semantic
@using ApologiaStudio.Application.AiRuntime.Settings
@inject IServiceScopeFactory ServiceScopeFactory
@inject IOllamaModelCatalogClient ModelCatalogClient

<section class="ollama-runtime-settings"
         aria-labelledby="ollama-runtime-settings-title">
    <header>
        <div>
            <p class="settings-kicker">IA · Ollama</p>
            <h2 id="ollama-runtime-settings-title">
                Modèles et exécution locale
            </h2>
            <p>
                Configuration du serveur Ollama, du routage, du modèle par
                défaut et des limites d’exécution communes aux agents.
            </p>
        </div>
        <span class="database-badge">PostgreSQL</span>
    </header>

    @if (_isLoadingSettings)
    {
        <p class="settings-status">
            Chargement des paramètres d’IA…
        </p>
    }
    else
    {
        <section class="runtime-settings"
                 aria-labelledby="runtime-settings-title">
            <div class="section-heading">
                <div>
                    <p class="settings-kicker">Runtime</p>
                    <h3 id="runtime-settings-title">Ollama</h3>
                </div>
                <p>
                    Configuration commune à tous les agents et au routeur.
                </p>
            </div>

            <div class="settings-grid">
                <label class="wide-field">
                    <span>Adresse du serveur Ollama</span>
                    <input type="url"
                           autocomplete="off"
                           spellcheck="false"
                           disabled="@(_isSavingRuntime || _isLoadingModels)"
                           value="@_baseAddress"
                           @onchange="HandleBaseAddressChangedAsync" />
                    <small>
                        Une adresse de bouclage est imposée
                        (127.0.0.1, localhost ou ::1).
                    </small>
                </label>

                <div class="model-field">
                    <label for="ollama-routing-model">
                        Modèle de routage sémantique
                    </label>
                    <OllamaModelSelect Id="ollama-routing-model"
                                       Models="@_models"
                                       Value="@_routingModel"
                                       ValueChanged="@SetRoutingModel"
                                       IsDisabled="@(_isSavingRuntime || _isLoadingModels)" />
                    <small>
                        Utilisé seulement lorsque le routeur déterministe ne
                        peut pas choisir l’agent avec assez de confiance.
                    </small>
                </div>

                <div class="model-field">
                    <label for="ollama-default-agent-model">
                        Modèle par défaut des agents
                    </label>
                    <OllamaModelSelect Id="ollama-default-agent-model"
                                       Models="@_models"
                                       Value="@_defaultAgentModel"
                                       ValueChanged="@SetDefaultAgentModel"
                                       IsDisabled="@(_isSavingRuntime || _isLoadingModels)" />
                    <small>
                        Utilisé lorsqu’un agent n’a pas de modèle spécifique.
                    </small>
                </div>
            </div>

            <section class="execution-settings"
                     aria-labelledby="execution-settings-title">
                <h4 id="execution-settings-title">
                    Limites d’exécution
                </h4>
                <div class="settings-grid">
                    <label>
                        <span>Délai maximal de routage</span>
                        <div class="number-field">
                            <input type="number"
                                   min="1"
                                   max="300"
                                   step="1"
                                   disabled="@_isSavingRuntime"
                                   @bind="_routingTimeoutSeconds" />
                            <span>secondes</span>
                        </div>
                    </label>
                    <label>
                        <span>Délai maximal de génération</span>
                        <div class="number-field">
                            <input type="number"
                                   min="1"
                                   max="600"
                                   step="1"
                                   disabled="@_isSavingRuntime"
                                   @bind="_generationTimeoutSeconds" />
                            <span>secondes</span>
                        </div>
                    </label>
                    <label>
                        <span>Conservation du modèle en mémoire</span>
                        <input type="text"
                               maxlength="32"
                               autocomplete="off"
                               spellcheck="false"
                               disabled="@_isSavingRuntime"
                               @bind="_keepAlive" />
                        <small>Exemples : 10m, 1h, 0 ou -1.</small>
                    </label>
                    <label>
                        <span>Messages d’historique maximum</span>
                        <input type="number"
                               min="1"
                               max="100"
                               step="1"
                               disabled="@_isSavingRuntime"
                               @bind="_maximumHistoryMessages" />
                    </label>
                    <label>
                        <span>Caractères d’historique maximum</span>
                        <input type="number"
                               min="1000"
                               max="100000"
                               step="1000"
                               disabled="@_isSavingRuntime"
                               @bind="_maximumHistoryCharacters" />
                    </label>
                    <label>
                        <span>Tokens de sortie maximum</span>
                        <input type="number"
                               min="64"
                               max="8192"
                               step="64"
                               disabled="@_isSavingRuntime"
                               @bind="_maximumOutputTokens" />
                    </label>
                </div>
            </section>

            <div class="catalog-actions">
                <p class="catalog-note">
                    La liste provient de <code>GET /api/tags</code> sur
                    l’adresse indiquée et contient les modèles installés.
                </p>
                <button class="secondary-action"
                        type="button"
                        disabled="@(_isSavingRuntime || _isLoadingModels)"
                        @onclick="RefreshModelsAsync">
                    @(_isLoadingModels ? "Chargement…" : "Actualiser les modèles")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_modelCatalogMessage))
            {
                <p class="catalog-message @(_modelCatalogIsError ? "error" : null)"
                   role="@(_modelCatalogIsError ? "alert" : "status")">
                    @_modelCatalogMessage
                </p>
            }

            <footer class="runtime-footer">
                <p class="settings-note">
                    Les changements runtime sont appliqués à la prochaine
                    requête.
                </p>
                <button type="button"
                        disabled="@(_isSavingRuntime ||
                                    _isLoadingModels ||
                                    !AreRuntimeModelsAvailable)"
                        @onclick="SaveRuntimeAsync">
                    @(_isSavingRuntime ? "Enregistrement…" : "Enregistrer le runtime")
                </button>
            </footer>

            @if (!string.IsNullOrWhiteSpace(_runtimeStatusMessage))
            {
                <p class="settings-status @(_runtimeStatusIsError ? "error" : "success")"
                   role="@(_runtimeStatusIsError ? "alert" : "status")">
                    @_runtimeStatusMessage
                </p>
            }
        </section>
    }
</section>
