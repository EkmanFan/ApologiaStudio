@rendermode InteractiveServer
@using Microsoft.Extensions.DependencyInjection
@using ApologiaStudio.AgentRuntime.Agents
@using ApologiaStudio.AgentRuntime.Routing.Semantic
@using ApologiaStudio.Application.Agents.Settings
@using ApologiaStudio.Application.AiRuntime.Settings
@inject IServiceScopeFactory ServiceScopeFactory
@inject IOllamaModelCatalogClient ModelCatalogClient
@inject BuiltInAgentSettingsCatalog AgentDefaults

<section class="ollama-routing-settings"
         aria-labelledby="ollama-routing-settings-title">
    <header>
        <div>
            <p class="settings-kicker">Ollama</p>
            <h2 id="ollama-routing-settings-title">
                Modèles et exécution locale
            </h2>
            <p>
                Les paramètres runtime et les profils d’agents sont
                enregistrés dans PostgreSQL. Les changements de modèle et de
                prompt sont relus au prochain tour d’agent, sans redémarrage.
            </p>
        </div>
        <span class="database-badge">PostgreSQL</span>
    </header>

    @if (_isLoadingSettings)
    {
        <p class="settings-status">
            Chargement des paramètres d’IA…
        </p>
    }
    else
    {
        <section class="runtime-settings"
                 aria-labelledby="runtime-settings-title">
            <div class="section-heading">
                <div>
                    <p class="settings-kicker">Runtime</p>
                    <h3 id="runtime-settings-title">Ollama</h3>
                </div>
                <p>
                    Configuration commune à tous les agents et au routeur.
                </p>
            </div>

            <div class="settings-grid">
                <label class="wide-field">
                    <span>Adresse du serveur Ollama</span>
                    <input type="url"
                           autocomplete="off"
                           spellcheck="false"
                           disabled="@(_isSavingRuntime || _isLoadingModels)"
                           value="@_baseAddress"
                           @onchange="HandleBaseAddressChangedAsync" />
                    <small>
                        Une adresse de bouclage est imposée
                        (127.0.0.1, localhost ou ::1).
                    </small>
                </label>

                <div class="model-field">
                    <label for="ollama-routing-model">
                        Modèle de routage sémantique
                    </label>
                    <OllamaModelSelect Id="ollama-routing-model"
                                       Models="@_models"
                                       Value="@_routingModel"
                                       ValueChanged="@SetRoutingModel"
                                       IsDisabled="@(_isSavingRuntime || _isLoadingModels)" />
                    <small>
                        Utilisé seulement lorsque le routeur déterministe ne
                        peut pas choisir l’agent avec assez de confiance.
                    </small>
                </div>

                <div class="model-field">
                    <label for="ollama-default-agent-model">
                        Modèle par défaut des agents
                    </label>
                    <OllamaModelSelect Id="ollama-default-agent-model"
                                       Models="@_models"
                                       Value="@_defaultAgentModel"
                                       ValueChanged="@SetDefaultAgentModel"
                                       IsDisabled="@(_isSavingRuntime || _isLoadingModels)" />
                    <small>
                        Utilisé lorsqu’un agent n’a pas de modèle spécifique.
                    </small>
                </div>
            </div>

            <section class="execution-settings"
                     aria-labelledby="execution-settings-title">
                <h4 id="execution-settings-title">
                    Limites d’exécution
                </h4>
                <div class="settings-grid">
                    <label>
                        <span>Délai maximal de routage</span>
                        <div class="number-field">
                            <input type="number"
                                   min="1"
                                   max="300"
                                   step="1"
                                   disabled="@_isSavingRuntime"
                                   @bind="_routingTimeoutSeconds" />
                            <span>secondes</span>
                        </div>
                    </label>
                    <label>
                        <span>Délai maximal de génération</span>
                        <div class="number-field">
                            <input type="number"
                                   min="1"
                                   max="600"
                                   step="1"
                                   disabled="@_isSavingRuntime"
                                   @bind="_generationTimeoutSeconds" />
                            <span>secondes</span>
                        </div>
                    </label>
                    <label>
                        <span>Conservation du modèle en mémoire</span>
                        <input type="text"
                               maxlength="32"
                               autocomplete="off"
                               spellcheck="false"
                               disabled="@_isSavingRuntime"
                               @bind="_keepAlive" />
                        <small>Exemples : 10m, 1h, 0 ou -1.</small>
                    </label>
                    <label>
                        <span>Messages d’historique maximum</span>
                        <input type="number"
                               min="1"
                               max="100"
                               step="1"
                               disabled="@_isSavingRuntime"
                               @bind="_maximumHistoryMessages" />
                    </label>
                    <label>
                        <span>Caractères d’historique maximum</span>
                        <input type="number"
                               min="1000"
                               max="100000"
                               step="1000"
                               disabled="@_isSavingRuntime"
                               @bind="_maximumHistoryCharacters" />
                    </label>
                    <label>
                        <span>Tokens de sortie maximum</span>
                        <input type="number"
                               min="64"
                               max="8192"
                               step="64"
                               disabled="@_isSavingRuntime"
                               @bind="_maximumOutputTokens" />
                    </label>
                </div>
            </section>

            <div class="catalog-actions">
                <p class="catalog-note">
                    La liste provient de <code>GET /api/tags</code> sur
                    l’adresse indiquée et contient les modèles installés.
                </p>
                <button class="secondary-action"
                        type="button"
                        disabled="@(_isSavingRuntime || _isLoadingModels)"
                        @onclick="RefreshModelsAsync">
                    @(_isLoadingModels ? "Chargement…" : "Actualiser les modèles")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_modelCatalogMessage))
            {
                <p class="catalog-message @(_modelCatalogIsError ? "error" : null)"
                   role="@(_modelCatalogIsError ? "alert" : "status")">
                    @_modelCatalogMessage
                </p>
            }

            <footer class="runtime-footer">
                <p class="settings-note">
                    Les changements runtime sont appliqués à la prochaine
                    requête.
                </p>
                <button type="button"
                        disabled="@(_isSavingRuntime ||
                                    _isLoadingModels ||
                                    !AreRuntimeModelsAvailable)"
                        @onclick="SaveRuntimeAsync">
                    @(_isSavingRuntime ? "Enregistrement…" : "Enregistrer le runtime")
                </button>
            </footer>

            @if (!string.IsNullOrWhiteSpace(_runtimeStatusMessage))
            {
                <p class="settings-status @(_runtimeStatusIsError ? "error" : "success")"
                   role="@(_runtimeStatusIsError ? "alert" : "status")">
                    @_runtimeStatusMessage
                </p>
            }
        </section>

        <section class="agents-settings"
                 aria-labelledby="agents-settings-title">
            <div class="section-heading">
                <div>
                    <p class="settings-kicker">Agents</p>
                    <h3 id="agents-settings-title">Profils des agents</h3>
                </div>
                <p>

                </p>
            </div>

            <div class="agent-stack">
                @foreach (var editor in _agentEditors)
                {
                    var isSavingAgent =
                        _savingAgentIds.Contains(editor.AgentId.Value);
                    var modelSelectId = $"agent-model-{editor.Slug}";
                    var nameInputId = $"agent-name-{editor.Slug}";
                    var avatarInputId = $"agent-avatar-{editor.Slug}";
                    var colorInputId = $"agent-color-{editor.Slug}";
                    var colorTextInputId = $"agent-color-text-{editor.Slug}";
                    var promptInputId = $"agent-prompt-{editor.Slug}";

                    <details class="agent-card">
                        <summary class="agent-card-summary">
                            <div class="agent-identity-preview"
                                 style="@GetAgentPreviewStyle(editor)">
                                <span class="agent-avatar-preview"
                                      aria-hidden="true">
                                    @editor.Avatar
                                </span>
                                <div>
                                    <strong>@editor.DisplayName</strong>
                                    <small>@editor.Slug</small>
                                </div>
                            </div>
                            <span class="agent-summary-meta">
                                <span class="agent-id"
                                      title="Identifiant technique immuable">
                                    @* @editor.AgentId.Value.ToString("D") *@
                                </span>
                                <span class="collapse-chevron"
                                      aria-hidden="true"></span>
                            </span>
                        </summary>

                        <div class="agent-card-body">
                            <div class="agent-fields-grid">
                                <label for="@nameInputId">
                                    <span>Nom</span>
                                    <input id="@nameInputId"
                                           type="text"
                                           maxlength="@AgentSettingsValidator.MaximumDisplayNameLength"
                                           disabled="@isSavingAgent"
                                           @bind="editor.DisplayName" />
                                </label>

                                <label for="@avatarInputId">
                                    <span>Avatar</span>
                                    <input id="@avatarInputId"
                                           type="text"
                                           maxlength="@AgentSettingsValidator.MaximumAvatarLength"
                                           disabled="@isSavingAgent"
                                           @bind="editor.Avatar" />
                                    <small>Emoji ou texte court pour le MVP.</small>
                                </label>

                                <div class="model-field">
                                    <label for="@modelSelectId">Modèle IA</label>
                                    <select id="@modelSelectId"
                                            disabled="@(isSavingAgent || _isLoadingModels)"
                                            @bind="editor.Model">
                                        <option value="">
                                            Modèle par défaut (@_defaultAgentModel)
                                        </option>
                                        @if (!string.IsNullOrWhiteSpace(editor.Model) &&
                                             !IsModelAvailable(editor.Model))
                                        {
                                            <option value="@editor.Model">
                                                @editor.Model — indisponible à cette adresse
                                            </option>
                                        }
                                        @foreach (var model in _models)
                                        {
                                            <option value="@model.Name">
                                                @model.DisplayName
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="color-field">
                                    <label for="@colorTextInputId">
                                        Couleur de bulle
                                    </label>
                                    <div class="color-input-row">
                                        <input id="@colorInputId"
                                               class="color-picker"
                                               type="color"
                                               disabled="@isSavingAgent"
                                               value="@NormalizeColorForPicker(editor.BubbleColor)"
                                               @onchange="eventArgs => SetAgentColor(editor, eventArgs)" />
                                        <input id="@colorTextInputId"
                                               type="text"
                                               maxlength="7"
                                               autocomplete="off"
                                               spellcheck="false"
                                               disabled="@isSavingAgent"
                                               @bind="editor.BubbleColor" />
                                    </div>
                                    <small>Format #RRGGBB.</small>
                                </div>
                            </div>

                            <details class="prompt-section">
                                <summary class="prompt-section-summary">
                                    <span>Prompt système</span>
                                    <span class="prompt-summary-meta">
                                        <small>@editor.SystemPrompt.Length caractère(s)</small>
                                        <span class="collapse-chevron"
                                              aria-hidden="true"></span>
                                    </span>
                                </summary>

                                <div class="prompt-field">
                                    <textarea id="@promptInputId"
                                              rows="14"
                                              maxlength="@AgentSettingsValidator.MaximumSystemPromptLength"
                                              spellcheck="false"
                                              aria-label="Prompt système"
                                              disabled="@isSavingAgent"
                                              @bind="editor.SystemPrompt"></textarea>
                                </div>
                            </details>

                            <footer class="agent-card-footer">
                                <div class="agent-status">
                                    @if (!string.IsNullOrWhiteSpace(editor.StatusMessage))
                                    {
                                        <span class="@(editor.StatusIsError ? "error" : "success")"
                                              role="@(editor.StatusIsError ? "alert" : "status")">
                                            @editor.StatusMessage
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Les changements sont utilisés au prochain tour d’agent.
                                        </span>
                                    }
                                </div>
                                <div class="agent-actions">
                                    <button class="secondary-action"
                                            type="button"
                                            disabled="@isSavingAgent"
                                            @onclick="() => ResetAgentToDefaults(editor)">
                                        Réinitialiser
                                    </button>
                                    <button type="button"
                                            disabled="@isSavingAgent"
                                            @onclick="() => SaveAgentAsync(editor)">
                                        @(isSavingAgent ? "Enregistrement…" : "Enregistrer")
                                    </button>
                                </div>
                            </footer>
                        </div>
                    </details>
                }
            </div>
        </section>
    }
</section>

@code {
    private IReadOnlyList<OllamaLocalModel> _models =
        Array.Empty<OllamaLocalModel>();
    private IReadOnlyList<AgentEditor> _agentEditors =
        Array.Empty<AgentEditor>();
    private IReadOnlyDictionary<Guid, string> _legacyAgentModels =
        new Dictionary<Guid, string>();
    private readonly HashSet<Guid> _savingAgentIds = [];

    private string _baseAddress = string.Empty;
    private string _routingModel = string.Empty;
    private string _defaultAgentModel = string.Empty;
    private string _keepAlive = string.Empty;
    private string? _runtimeStatusMessage;
    private string? _modelCatalogMessage;
    private int _routingTimeoutSeconds;
    private int _generationTimeoutSeconds;
    private int _maximumHistoryMessages;
    private int _maximumHistoryCharacters;
    private int _maximumOutputTokens;
    private int _modelLoadVersion;
    private bool _isLoadingSettings = true;
    private bool _isLoadingModels;
    private bool _isSavingRuntime;
    private bool _runtimeStatusIsError;
    private bool _modelCatalogIsError;

    private bool AreRuntimeModelsAvailable =>
        IsModelAvailable(_routingModel) &&
        IsModelAvailable(_defaultAgentModel);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var scope =
                ServiceScopeFactory.CreateAsyncScope();

            var runtimeHandler =
                scope.ServiceProvider.GetRequiredService<
                    GetAiRuntimeSettingsHandler>();
            var agentHandler =
                scope.ServiceProvider.GetRequiredService<
                    GetAgentSettingsHandler>();

            var runtimeSettings =
                await runtimeHandler.HandleAsync(
                    CancellationToken.None);
            var agentSettings =
                await agentHandler.HandleAsync(
                    CancellationToken.None);

            LoadRuntime(runtimeSettings);
            LoadAgents(agentSettings);
            await LoadModelsAsync(showSuccess: false);
        }
        catch (Exception exception)
        {
            _runtimeStatusIsError = true;
            _runtimeStatusMessage =
                "Les paramètres d’IA n’ont pas pu être chargés : " +
                exception.Message;
        }
        finally
        {
            _isLoadingSettings = false;
        }
    }

    private void SetRoutingModel(string value)
    {
        _routingModel = value;
    }

    private void SetDefaultAgentModel(string value)
    {
        _defaultAgentModel = value;
    }

    private async Task HandleBaseAddressChangedAsync(
        ChangeEventArgs eventArgs)
    {
        _baseAddress =
            eventArgs.Value?.ToString()?.Trim()
            ?? string.Empty;

        _runtimeStatusMessage = null;
        await LoadModelsAsync(showSuccess: false);
    }

    private Task RefreshModelsAsync()
    {
        return LoadModelsAsync(showSuccess: true);
    }

    private async Task LoadModelsAsync(bool showSuccess)
    {
        var loadVersion = ++_modelLoadVersion;

        _isLoadingModels = true;
        _modelCatalogMessage = null;
        _modelCatalogIsError = false;

        try
        {
            var baseAddress =
                AiRuntimeSettingsValidator.NormalizeBaseAddress(
                    _baseAddress);
            var models =
                await ModelCatalogClient.ListLocalModelsAsync(
                    baseAddress);

            if (loadVersion != _modelLoadVersion)
            {
                return;
            }

            _models = models;
            if (_models.Count == 0)
            {
                _modelCatalogIsError = true;
                _modelCatalogMessage =
                    "Aucun modèle local n’est installé sur ce serveur Ollama.";
                return;
            }

            var unavailable = GetUnavailableSelections();
            if (unavailable.Count > 0)
            {
                _modelCatalogIsError = true;
                _modelCatalogMessage =
                    "Modèle(s) configuré(s) indisponible(s) : " +
                    string.Join(", ", unavailable) +
                    ". Sélectionnez un modèle installé localement.";
            }
            else if (showSuccess)
            {
                _modelCatalogMessage =
                    $"{_models.Count} modèle(s) local(aux) chargé(s).";
            }
        }
        catch (Exception exception)
            when (exception is ArgumentException or
                  HttpRequestException or
                  InvalidOperationException or
                  TaskCanceledException)
        {
            _models = Array.Empty<OllamaLocalModel>();
            _modelCatalogIsError = true;
            _modelCatalogMessage =
                "Impossible de charger les modèles locaux : " +
                exception.Message;
        }
        finally
        {
            if (loadVersion == _modelLoadVersion)
            {
                _isLoadingModels = false;
            }
        }
    }

    private async Task SaveRuntimeAsync()
    {
        if (_isSavingRuntime)
        {
            return;
        }

        _isSavingRuntime = true;
        _runtimeStatusMessage = null;
        _runtimeStatusIsError = false;

        try
        {
            if (!AreRuntimeModelsAvailable)
            {
                throw new InvalidOperationException(
                    "Les modèles du runtime doivent être installés sur " +
                    "le serveur Ollama indiqué.");
            }

            var assignments = _legacyAgentModels
                .Select(
                    assignment =>
                        new AgentModelAssignmentInput(
                            assignment.Key,
                            assignment.Value))
                .ToArray();

            await using var scope =
                ServiceScopeFactory.CreateAsyncScope();
            var handler =
                scope.ServiceProvider.GetRequiredService<
                    UpdateAiRuntimeSettingsHandler>();

            var settings =
                await handler.HandleAsync(
                    new UpdateAiRuntimeSettingsCommand(
                        _baseAddress,
                        _routingModel,
                        _defaultAgentModel,
                        _routingTimeoutSeconds,
                        _generationTimeoutSeconds,
                        _keepAlive,
                        _maximumHistoryMessages,
                        _maximumHistoryCharacters,
                        _maximumOutputTokens,
                        assignments),
                    CancellationToken.None);

            LoadRuntime(settings);
            _runtimeStatusMessage =
                "Les paramètres du runtime ont été enregistrés dans PostgreSQL.";
        }
        catch (Exception exception)
            when (exception is ArgumentException or
                  InvalidOperationException or
                  IOException or
                  UnauthorizedAccessException)
        {
            _runtimeStatusIsError = true;
            _runtimeStatusMessage = exception.Message;
        }
        finally
        {
            _isSavingRuntime = false;
        }
    }

    private async Task SaveAgentAsync(AgentEditor editor)
    {
        if (!_savingAgentIds.Add(editor.AgentId.Value))
        {
            return;
        }

        editor.StatusMessage = null;
        editor.StatusIsError = false;

        try
        {
            if (_models.Count > 0 &&
                !IsOptionalModelAvailable(editor.Model))
            {
                throw new InvalidOperationException(
                    "Le modèle sélectionné pour cet agent n’est pas installé " +
                    "sur le serveur Ollama indiqué.");
            }

            await using var scope =
                ServiceScopeFactory.CreateAsyncScope();
            var handler =
                scope.ServiceProvider.GetRequiredService<
                    UpdateAgentSettingsHandler>();

            var saved =
                await handler.HandleAsync(
                    new UpdateAgentSettingsCommand(
                        editor.AgentId,
                        editor.DisplayName,
                        editor.Avatar,
                        editor.BubbleColor,
                        string.IsNullOrWhiteSpace(editor.Model)
                            ? null
                            : editor.Model,
                        editor.SystemPrompt),
                    CancellationToken.None);

            editor.Load(saved);
            editor.StatusMessage =
                "Profil enregistré. Il sera utilisé dès le prochain tour.";
        }
        catch (Exception exception)
            when (exception is ArgumentException or
                  InvalidOperationException or
                  IOException or
                  UnauthorizedAccessException)
        {
            editor.StatusIsError = true;
            editor.StatusMessage = exception.Message;
        }
        finally
        {
            _savingAgentIds.Remove(editor.AgentId.Value);
        }
    }

    private void ResetAgentToDefaults(AgentEditor editor)
    {
        var defaults = AgentDefaults.Get(editor.AgentId);
        editor.DisplayName = defaults.Agent.DisplayName;
        editor.Avatar = defaults.Avatar;
        editor.BubbleColor = defaults.BubbleColor;
        editor.Model = string.Empty;
        editor.SystemPrompt = defaults.Prompt.SystemPrompt;
        editor.StatusIsError = false;
        editor.StatusMessage =
            "Valeurs par défaut restaurées localement. Enregistrez pour les appliquer.";
    }

    private void LoadRuntime(AiRuntimeSettingsSnapshot settings)
    {
        _baseAddress = settings.BaseAddress;
        _routingModel = settings.RoutingModel;
        _defaultAgentModel = settings.DefaultAgentModel;
        _routingTimeoutSeconds = settings.RoutingTimeoutSeconds;
        _generationTimeoutSeconds = settings.GenerationTimeoutSeconds;
        _keepAlive = settings.KeepAlive;
        _maximumHistoryMessages = settings.MaximumHistoryMessages;
        _maximumHistoryCharacters = settings.MaximumHistoryCharacters;
        _maximumOutputTokens = settings.MaximumOutputTokens;
        _legacyAgentModels =
            new Dictionary<Guid, string>(settings.AgentModels);
    }

    private void LoadAgents(
        IReadOnlyList<AgentSettingsSnapshot> persistedSettings)
    {
        var byId = persistedSettings.ToDictionary(
            settings => settings.AgentId);

        _agentEditors = AgentDefaults.All
            .Select(
                defaults =>
                {
                    if (byId.TryGetValue(
                            defaults.Agent.Id,
                            out var persisted))
                    {
                        return AgentEditor.From(
                            defaults.Agent.Slug,
                            persisted);
                    }

                    return new AgentEditor(
                        defaults.Agent.Id,
                        defaults.Agent.Slug,
                        defaults.Agent.DisplayName,
                        defaults.Avatar,
                        defaults.BubbleColor,
                        string.Empty,
                        defaults.Prompt.SystemPrompt);
                })
            .ToArray();
    }

    private bool IsModelAvailable(string model)
    {
        return _models.Any(
            candidate =>
                string.Equals(
                    candidate.Name,
                    model,
                    StringComparison.OrdinalIgnoreCase));
    }

    private bool IsOptionalModelAvailable(string? model)
    {
        return string.IsNullOrWhiteSpace(model) ||
               IsModelAvailable(model);
    }

    private IReadOnlyList<string> GetUnavailableSelections()
    {
        return new[]
            {
                _routingModel,
                _defaultAgentModel
            }
            .Concat(
                _agentEditors
                    .Select(editor => editor.Model))
            .Where(model => !string.IsNullOrWhiteSpace(model))
            .Cast<string>()
            .Where(model => !IsModelAvailable(model))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static void SetAgentColor(
        AgentEditor editor,
        ChangeEventArgs eventArgs)
    {
        var value = eventArgs.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(value))
        {
            editor.BubbleColor = value.ToUpperInvariant();
        }
    }

    private static string NormalizeColorForPicker(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) ||
            value.Length != 7 ||
            value[0] != '#' ||
            !int.TryParse(
                value.AsSpan(1),
                System.Globalization.NumberStyles.HexNumber,
                null,
                out _))
        {
            return "#F3F2EE";
        }

        return value;
    }

    private static string GetAgentPreviewStyle(AgentEditor editor)
    {
        var color = NormalizeColorForPicker(editor.BubbleColor);
        return $"--agent-preview-color:{color};";
    }

    private sealed class AgentEditor(
        ApologiaStudio.Domain.Agents.AgentId agentId,
        string slug,
        string displayName,
        string avatar,
        string bubbleColor,
        string model,
        string systemPrompt)
    {
        public ApologiaStudio.Domain.Agents.AgentId AgentId { get; } = agentId;
        public string Slug { get; } = slug;
        public string DisplayName { get; set; } = displayName;
        public string Avatar { get; set; } = avatar;
        public string BubbleColor { get; set; } = bubbleColor;
        public string Model { get; set; } = model;
        public string SystemPrompt { get; set; } = systemPrompt;
        public string? StatusMessage { get; set; }
        public bool StatusIsError { get; set; }

        public static AgentEditor From(
            string slug,
            AgentSettingsSnapshot settings)
        {
            return new AgentEditor(
                settings.AgentId,
                slug,
                settings.DisplayName,
                settings.Avatar,
                settings.BubbleColor,
                settings.Model ?? string.Empty,
                settings.SystemPrompt);
        }

        public void Load(AgentSettingsSnapshot settings)
        {
            DisplayName = settings.DisplayName;
            Avatar = settings.Avatar;
            BubbleColor = settings.BubbleColor;
            Model = settings.Model ?? string.Empty;
            SystemPrompt = settings.SystemPrompt;
        }
    }
}
