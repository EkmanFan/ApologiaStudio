<Project Sdk="Microsoft.NET.Sdk.Web">

    <ItemGroup>
      <ProjectReference Include="..\ApologiaStudio.Application\ApologiaStudio.Application.csproj" />
      <ProjectReference Include="..\ApologiaStudio.AgentRuntime\ApologiaStudio.AgentRuntime.csproj" />
      <ProjectReference Include="..\ApologiaStudio.Infrastructure\ApologiaStudio.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
      <UserSecretsId>221e6f41-ea72-4db3-b841-e12568625099</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The worker's own source travels with the application, so the
         supervisor has one to run without depending on the repository. -->
    <Content Include="..\..\tools\encoder-worker\encoder_worker.py"
             Link="encoder-worker\encoder_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
