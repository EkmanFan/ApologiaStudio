{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocumentManager": {
    "UiUrl": "http://localhost:5092/"
  },
  "DocumentManagerAdministration": {
    "Enabled": false
  },
  "IdentityBootstrap": {
    "Enabled": false,
    "DisplayName": "Apologia Administrator"
  },
  "DocumentManagerConsumer": {
    "Enabled": false,
    "ReconciliationSeconds": 300,
    "RetrySeconds": 10,
    "MaximumNotificationAgeSeconds": 300,
    "RequestTimeoutSeconds": 120
  },
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434",
    "RoutingModel": "qwen3:8b",
    "TimeoutSeconds": 60,
    "KeepAlive": "10m",
    "RoutingSettingsPath": "App_Data/ollama-routing-settings.json"
  }
}
